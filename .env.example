# Variables de entorno de transport.
# Copia este archivo a `.env` (que está en .gitignore) y llena solo lo que necesites.
# NUNCA subas valores reales al repo. Todas las claves externas son opcionales en
# desarrollo: el código debe degradarse con elegancia si faltan.

# --- Supabase ---------------------------------------------------------------
# Local: `supabase start` imprime la URL y las claves de desarrollo.
# Nube (staging/prod): los proyectos aún no existen (B27).
SUPABASE_URL=http://127.0.0.1:54321
# Clave pública (anon/publishable). Es la única que usan las apps.
SUPABASE_ANON_KEY=
# Service role: SOLO para Edge Functions y CI. Nunca en código de web ni móvil.
SUPABASE_SERVICE_ROLE_KEY=

# Expuestas al cliente (mismos valores que arriba, con el prefijo de cada framework).
# La web (Next.js) lee sus variables de apps/web/.env.local. Sin URL y anon key,
# la web muestra un aviso y nadie puede iniciar sesión.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública de la web, para los enlaces de los correos de Auth (B11).
# Si está vacía, se usa el origen de la petición.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# App móvil (B17): en un teléfono físico usa la IP de tu computadora en la LAN
# (p. ej. http://192.168.1.20:54321) y en el emulador de Android http://10.0.2.2:54321.
# Las builds de release solo aceptan https.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# GPS en segundo plano del operador (B22): un punto cada ~N segundos o cada ~M metros
# durante un viaje activo. Vacío o fuera de rango (15–600 s, 100–5000 m): 60 s y 500 m.
EXPO_PUBLIC_TRACKING_INTERVAL_S=
EXPO_PUBLIC_TRACKING_DISTANCE_M=
# URL pública de la web (B27): la app enlaza ahí el aviso de privacidad y los términos, y
# "Compartir con mi equipo" (G7) manda https://<sitio>/transportista/compartido/<token>.
# Solo https (o http en localhost). Vacía: la app no muestra esos enlaces y comparte el
# deep link transport://compartido/<token>.
EXPO_PUBLIC_SITE_URL=
# Pruebas de Maestro en el simulador de iOS (no en Android), que no tiene cámara (F14): con 1, en una
# build de desarrollo "Tomar foto" usa una foto fija en vez de la cámara. Las builds de
# release la ignoran. Déjala vacía para usar la app normalmente.
EXPO_PUBLIC_E2E_FAKE_CAMERA=

# --- Puertos locales alternos (opcional) -------------------------------------
# Sin estas variables: Supabase en 54320–54329 y web en 3000 (los de config.toml).
# Para otros puertos sin editar config.toml: eval "$(sh scripts/local-ports.sh 563)"
# (ver CONTRIBUTING.md). Supabase CLI aplica SUPABASE_<SECCIÓN>_<CLAVE> sobre config.toml.
# SUPABASE_API_PORT=56321
# SUPABASE_DB_PORT=56322
# SUPABASE_DB_SHADOW_PORT=56320
# SUPABASE_DB_POOLER_PORT=56329
# SUPABASE_STUDIO_PORT=56323
# SUPABASE_LOCAL_SMTP_PORT=56324
# SUPABASE_ANALYTICS_PORT=56327
# SUPABASE_EDGE_RUNTIME_INSPECTOR_PORT=56383
# SUPABASE_AUTH_SITE_URL=http://127.0.0.1:3020
# SUPABASE_AUTH_ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:3020/**,http://localhost:3020/**,transport://auth/callback
# Puerto de la web (next dev / next start).
# PORT=3020
# Playwright (e2e/README.md): web bajo prueba y Mailpit.
# E2E_BASE_URL=http://127.0.0.1:3020
# E2E_MAILPIT_URL=http://127.0.0.1:56324

# --- Google Maps Platform (B08, B13, B15, B19) ----------------------------
# Sin clave: la web y la app muestran un placeholder de mapa.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Web (B13): Places Autocomplete del formulario de cargas y vista previa de la ruta.
# Sin clave: ciudades predefinidas del corredor y un diagrama en lugar del mapa.
# Map ID para el mapa de la web (marcadores avanzados). Vacío: DEMO_MAP_ID de Google.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
# Routes API (solo servidor / Edge Functions). Sin clave: distancia haversine x factor de carretera.
# La Edge Function `recommendations` (B08) solo la usa para el top N y siempre a través de
# route_distance_cache (necesita SUPABASE_SERVICE_ROLE_KEY, que Supabase inyecta en las funciones).
# Local: ponla en supabase/functions/.env y corre `supabase functions serve`.
GOOGLE_ROUTES_API_KEY=
ROAD_DISTANCE_FACTOR=1.3

# --- Matching (B08) ----------------------------------------------------------
# Pesos del scoring en JSON (opcional; las claves que falten usan el valor por defecto de
# packages/shared/src/matching/scoring.ts). Ej.: {"pricePerKm":2,"emptyKm":0.2,"routeMatch":15}
MATCHING_WEIGHTS=

# --- Expo / EAS (B17, B27) --------------------------------------------------
# Sin project id: la app funciona, pero no obtiene push token (sin notificaciones).
EXPO_PUBLIC_EAS_PROJECT_ID=
# Bundle id de iOS y paquete de Android (opcional; por defecto mx.transport.app).
APP_BUNDLE_ID=
# Token de EAS solo para CI (builds y submit).
EXPO_TOKEN=

# --- Notificaciones: push y email (B09) ---------------------------------------
# Edge Function `dispatch-notifications` (local: supabase/functions/.env). La llama pg_cron
# con este secreto en el header `x-dispatch-secret` (guárdalo también en Vault, ver
# docs/demo-local.md). Sin secreto la función rechaza toda llamada.
NOTIFICATIONS_DISPATCH_SECRET=
# Token de acceso de Expo para push (opcional; solo si activas "push security" en Expo).
EXPO_ACCESS_TOKEN=
# Email transaccional con Resend. Sin clave o sin remitente: el envío de email se simula
# (se registra, no se envía). EMAIL_FROM, p. ej. "Avisos <avisos@tudominio.mx>".
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
# URL pública de la web para los enlaces de los correos. Vacía: correos sin enlace.
SITE_URL=

# --- Sentry y logs (B25) -----------------------------------------------------
# Opcional: sin DSN válido, Sentry no se inicializa (los errores solo quedan en los
# logs). El DSN es público por diseño. Los eventos se limpian antes de salir: sin
# correos, teléfonos, ubicaciones ni tokens (packages/shared/src/observability).
# Web (Next.js: navegador, Node y edge).
NEXT_PUBLIC_SENTRY_DSN=
# development | staging | production. Vacío: development.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Versión que se reporta (p. ej. el SHA del commit). Opcional.
NEXT_PUBLIC_SENTRY_RELEASE=
# Fracción de trazas de rendimiento (0–1). Vacío o inválido: 0.1.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# App móvil (mismo significado).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Edge Functions (local: supabase/functions/.env; nube: secretos de la función).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
# Nivel de los logs estructurados (JSON por línea) de las Edge Functions:
# debug | info | warn | error. Vacío: info.
LOG_LEVEL=
# Solo en builds (CI/Vercel/EAS, B27): subir source maps. Sin los tres, el build
# funciona igual y no sube nada.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Despliegue (B27) ---------------------------------------------------------
# No van en .env: son secretos de los GitHub Environments `staging` y `production`
# (Settings > Environments), y los lee solo CI. Guía completa: docs/release.md.
#   SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, SUPABASE_DB_PASSWORD  (migraciones y funciones)
#   VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID                     (web)
#   EXPO_TOKEN                                                         (EAS Build y Submit)
# Variables (no secretas) de GitHub: EAS_PROJECT_ID (repo), ASC_APP_ID (App Store Connect) y WEB_STAGING_ALIAS.
