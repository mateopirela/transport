# Variables de entorno de transport.
# Copia este archivo a `.env` (que está en .gitignore) y llena solo lo que necesites.
# NUNCA subas valores reales al repo. Todas las claves externas son opcionales en
# desarrollo: el código debe degradarse con elegancia si faltan.

# --- Supabase ---------------------------------------------------------------
# Local: `supabase start` imprime la URL y las claves de desarrollo.
# Nube (staging/prod): los proyectos aún no existen (B27).
SUPABASE_URL=http://127.0.0.1:54321
# Clave pública (anon/publishable). Es la única que usan las apps.
SUPABASE_ANON_KEY=
# Service role: SOLO para Edge Functions y CI. Nunca en código de web ni móvil.
SUPABASE_SERVICE_ROLE_KEY=

# Expuestas al cliente (mismos valores que arriba, con el prefijo de cada framework).
# La web (Next.js) lee sus variables de apps/web/.env.local. Sin URL y anon key,
# la web muestra un aviso y nadie puede iniciar sesión.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública de la web, para los enlaces de los correos de Auth (B11).
# Si está vacía, se usa el origen de la petición.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# App móvil (B17): en un teléfono físico usa la IP de tu computadora en la LAN
# (p. ej. http://192.168.1.20:54321) y en el emulador de Android http://10.0.2.2:54321.
# Las builds de release solo aceptan https.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# GPS en segundo plano del operador (B22): un punto cada ~N segundos o cada ~M metros
# durante un viaje activo. Vacío o fuera de rango (15–600 s, 100–5000 m): 60 s y 500 m.
EXPO_PUBLIC_TRACKING_INTERVAL_S=
EXPO_PUBLIC_TRACKING_DISTANCE_M=

# --- Google Maps Platform (B08, B13, B15, B19) ----------------------------
# Sin clave: la web y la app muestran un placeholder de mapa.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Web (B13): Places Autocomplete del formulario de cargas y vista previa de la ruta.
# Sin clave: ciudades predefinidas del corredor y un diagrama en lugar del mapa.
# Map ID para el mapa de la web (marcadores avanzados). Vacío: DEMO_MAP_ID de Google.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
# Routes API (solo servidor / Edge Functions). Sin clave: distancia haversine x factor de carretera.
# La Edge Function `recommendations` (B08) solo la usa para el top N y siempre a través de
# route_distance_cache (necesita SUPABASE_SERVICE_ROLE_KEY, que Supabase inyecta en las funciones).
# Local: ponla en supabase/functions/.env y corre `supabase functions serve`.
GOOGLE_ROUTES_API_KEY=
ROAD_DISTANCE_FACTOR=1.3

# --- Matching (B08) ----------------------------------------------------------
# Pesos del scoring en JSON (opcional; las claves que falten usan el valor por defecto de
# packages/shared/src/matching/scoring.ts). Ej.: {"pricePerKm":2,"emptyKm":0.2,"routeMatch":15}
MATCHING_WEIGHTS=

# --- Expo / EAS (B17, B27) --------------------------------------------------
# Sin project id: la app funciona, pero no obtiene push token (sin notificaciones).
EXPO_PUBLIC_EAS_PROJECT_ID=
# Bundle id de iOS y paquete de Android (opcional; por defecto mx.transport.app).
APP_BUNDLE_ID=
# Token de EAS solo para CI (builds y submit).
EXPO_TOKEN=

# --- Email transaccional (B09) ----------------------------------------------
# Sin clave: el envío de email se simula (se registra, no se envía).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# --- Sentry (B25) -----------------------------------------------------------
# Opcional: si está vacío, Sentry no se inicializa.
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
