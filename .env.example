# Variables de entorno de transport.
# Copia este archivo a `.env` (que está en .gitignore) y llena solo lo que necesites.
# NUNCA subas valores reales al repo. Todas las claves externas son opcionales en
# desarrollo: el código debe degradarse con elegancia si faltan.

# --- Supabase ---------------------------------------------------------------
# Local: `supabase start` imprime la URL y las claves de desarrollo.
# Nube (staging/prod): los proyectos aún no existen (B27).
SUPABASE_URL=http://127.0.0.1:54321
# Clave pública (anon/publishable). Es la única que usan las apps.
SUPABASE_ANON_KEY=
# Service role: SOLO para Edge Functions y CI. Nunca en código de web ni móvil.
SUPABASE_SERVICE_ROLE_KEY=

# Expuestas al cliente (mismos valores que arriba, con el prefijo de cada framework).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Google Maps Platform (B08, B13, B15, B19) ----------------------------
# Sin clave: la web y la app muestran un placeholder de mapa.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
# Routes API (solo servidor / Edge Functions). Sin clave: distancia haversine x factor de carretera.
GOOGLE_ROUTES_API_KEY=
ROAD_DISTANCE_FACTOR=1.3

# --- Expo / EAS (B17, B27) --------------------------------------------------
EXPO_PUBLIC_EAS_PROJECT_ID=
# Token de EAS solo para CI (builds y submit).
EXPO_TOKEN=

# --- Email transaccional (B09) ----------------------------------------------
# Sin clave: el envío de email se simula (se registra, no se envía).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# --- Sentry (B25) -----------------------------------------------------------
# Opcional: si está vacío, Sentry no se inicializa.
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
