    "doctor": "expo-doctor",
    "export": "expo export --platform ios --platform android --output-dir dist"
  },
  "dependencies": {
    "@expo/vector-icons": "~15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.117.3",
    "@transport/shared": "workspace:*",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "19.3.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/react"
      ]
    }
