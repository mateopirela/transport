{
  "name": "@transport/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
