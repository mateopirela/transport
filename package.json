{
  "name": "transport",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "turbo run lint //#lint:root",
    "lint:root": "eslint --max-warnings=0 *.js",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:types": "sh scripts/db-types.sh",
    "e2e:mobile": "node scripts/e2e-mobile.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "catalog:",
    "typescript-eslint": "8.71.2",
    "vitest": "catalog:"
  }
}
